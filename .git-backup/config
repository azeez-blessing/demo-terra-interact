[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://gitlab.com/multi-env/mult-env-example.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
[branch "ticket-LC-mod-testing"]
	vscode-merge-base = origin/main
[remote "git-hub-origin"]
	url = https://github.com/azeez-abp/terraform-work-infra.git
	fetch = +refs/heads/*:refs/remotes/git-hub-origin/*
